<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PodcastRecorder.Audio.PortAudio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- PortAudio builds for Linux and macOS; Windows uses WASAPI through NAudio instead. -->
  <ItemGroup>
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-x64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.linux-aarch64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-x64" Version="1.0.6" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-arm64" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodcastRecorder.Audio\PodcastRecorder.Audio.csproj" />
  </ItemGroup>

</Project>
