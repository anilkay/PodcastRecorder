<Window x:Class="PodcastRecorder.App.LiveSettingsWindow"
        Icon="pack://application:,,,/Assets/logo.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PodcastRecorder.App.Localization"
        xmlns:services="clr-namespace:PodcastRecorder.App.Services"
        Title="{loc:T Live_CanliYayinAyarlari}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                   Text="{loc:T Live_KaydaGidenSesMasterBir}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,12,8" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="{loc:T Live_Sunucu}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" ToolTip="{loc:T Live_OrYayinExampleComHttp}" />

            <TextBlock Grid.Row="1" Text="{loc:T Live_Port}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Width="90" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="2" Text="{loc:T Live_Mount}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MountBox" ToolTip="{loc:T Live_OrCanli}" />

            <TextBlock Grid.Row="3" Text="{loc:T Live_Kullanici}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" ToolTip="{loc:T Live_IcecastTeGeneldeSource}" />

            <TextBlock Grid.Row="4" Text="{loc:T Live_Sifre}" />
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" Padding="4,3"
                         ToolTip="{loc:T Live_WindowsKullanicinizaSifrelenmisOlara}" />

            <TextBlock Grid.Row="5" Text="{loc:T Live_Kalite}" />
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="BitrateBox" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

            <TextBlock Grid.Row="6" Text="{loc:T Live_YayinAdi}" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="NameBox" ToolTip="{loc:T Live_DinleyicilerinGorduguAdIstegeBagli}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" services:ButtonAssist.Icon="&#xE74E;" Content="{loc:T Live_Kaydet}" IsDefault="True" MinWidth="90" Click="Save_Click" />
            <Button Content="{loc:T Main_Iptal}" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
