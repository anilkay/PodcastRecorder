<Window x:Class="PodcastRecorder.App.LiveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canlı yayın ayarları" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                   Text="Kayda giden ses (Master) bir Icecast sunucusuna MP3 olarak gönderilir. Bilgileri yayın sunucunuzdan alın." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,12,8" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="Sunucu:" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" ToolTip="ör. yayin.example.com (http:// olmadan)" />

            <TextBlock Grid.Row="1" Text="Port:" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Width="90" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="2" Text="Mount:" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MountBox" ToolTip="ör. /canli" />

            <TextBlock Grid.Row="3" Text="Kullanıcı:" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" ToolTip="Icecast'te genelde &quot;source&quot;" />

            <TextBlock Grid.Row="4" Text="Şifre:" />
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" Padding="4,3"
                         ToolTip="Windows kullanıcınıza şifrelenmiş olarak saklanır" />

            <TextBlock Grid.Row="5" Text="Kalite:" />
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="BitrateBox" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8" />

            <TextBlock Grid.Row="6" Text="Yayın adı:" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="NameBox" ToolTip="Dinleyicilerin gördüğü ad (isteğe bağlı)" />
        </Grid>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kaydet" IsDefault="True" MinWidth="90" Click="Save_Click" />
            <Button Content="İptal" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
