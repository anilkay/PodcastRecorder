<Application x:Class="PodcastRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PodcastRecorder.App.Localization"
             xmlns:services="clr-namespace:PodcastRecorder.App.Services"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swapped by ThemeService: the Fluent control theme, then the app colours. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- The app's own buttons; merged last so they win over Fluent's. -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>

            <!-- Buttons and toggle buttons are styled in Themes/Controls.xaml. -->

            <Style x:Key="VerticalMeter" TargetType="ProgressBar">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Foreground" Value="{DynamicResource MeterBrush}" />
                <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- Own template: a plain bar that fills upwards, the same in every theme. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Grid.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </Grid.LayoutTransform>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One mixer strip: name, fader, stereo meter and mute. -->
            <DataTemplate x:Key="ChannelStripTemplate">
                <Border Style="{StaticResource PanelBorder}" Width="120" Margin="0,0,8,0" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE711;"
                                    Command="{Binding RemoveCommand}" Padding="4,2" MinWidth="0" MinHeight="0" Margin="0"
                                    ToolTip="{loc:T Strip_MikrofonuKaldir}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" ToolTip="{Binding DeviceName}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DeviceName}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" ToolTip="{Binding DeviceName}" />
                        <CheckBox DockPanel.Dock="Bottom" Content="{loc:T Main_Kulaklik}" IsChecked="{Binding MonitorEnabled}" Margin="0,4,0,0"
                                  ToolTip="{loc:T Strip_KulakliktaDuyKapaliykenDeKayda}" />
                        <ToggleButton DockPanel.Dock="Bottom" Style="{StaticResource MuteToggle}" Content="{loc:T Strip_Sessiz}" IsChecked="{Binding IsMuted}"
                                      Margin="0,6,0,0" HorizontalAlignment="Stretch" ToolTip="{loc:T Strip_KanaliSustur}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding Volume}"
                                    SmallChange="0.05" LargeChange="0.1" Margin="0,0,8,0"
                                    ToolTip="{loc:T Strip_SesSeviyesi}" />
                            <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding Meter.Left, Mode=OneWay}" />
                            <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding Meter.Right, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Margin="4,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource RecordBrush}"
                                     ToolTip="{loc:T Main_KirpilmaClip}"
                                     Visibility="{Binding Meter.IsClipping, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
