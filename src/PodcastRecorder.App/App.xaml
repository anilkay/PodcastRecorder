<Application x:Class="PodcastRecorder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6670" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDB" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCE7FB" />
        <SolidColorBrush x:Key="RecordBrush" Color="#D93A3A" />
        <SolidColorBrush x:Key="RecordSoftBrush" Color="#FBE3E3" />
        <SolidColorBrush x:Key="MeterBrush" Color="#3DAA5C" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RecordBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="32" />
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="96" />
        </Style>

        <Style x:Key="VerticalMeter" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{StaticResource MeterBrush}" />
            <Setter Property="Background" Value="#E6E8EC" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- One mixer strip: name, fader, stereo meter and mute. -->
        <DataTemplate x:Key="ChannelStripTemplate">
            <Border Style="{StaticResource PanelBorder}" Width="120" Margin="0,0,8,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <CheckBox DockPanel.Dock="Bottom" Content="Kulaklıkta duy" IsChecked="{Binding MonitorEnabled}" Margin="0,4,0,0"
                              ToolTip="Kapalıyken de kayda girer; sadece kulaklıkta duyulmaz." />
                    <ToggleButton DockPanel.Dock="Bottom" Content="Sessiz" IsChecked="{Binding IsMuted}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding Volume}"
                                SmallChange="0.05" LargeChange="0.1" Margin="0,0,8,0"
                                ToolTip="Ses seviyesi" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding Meter.Left, Mode=OneWay}" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding Meter.Right, Mode=OneWay}" />
                        <Ellipse Width="8" Height="8" Margin="4,0,0,0" VerticalAlignment="Top" Fill="{StaticResource RecordBrush}"
                                 ToolTip="Kırpılma (clip)"
                                 Visibility="{Binding Meter.IsClipping, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Application.Resources>
</Application>
