<Window x:Class="PodcastRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PodcastRecorder.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PodcastRecorder.App.ViewModels"
        xmlns:services="clr-namespace:PodcastRecorder.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Podcast Recorder" Height="820" Width="1280" MinHeight="640" MinWidth="1000"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13">
    <!-- Keyboard shortcuts. Jingle pad keys (1-8, Q-I, A-K, Z-M by grid position) are handled in code-behind. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding StartRecordingCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding StopRecordingCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMicrophoneCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding Live.StartCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding Live.StopCommand}" />
        <KeyBinding Key="F5" Command="{Binding Playlist.PlayCommand}" />
        <KeyBinding Key="F6" Command="{Binding Playlist.StopCommand}" />
        <KeyBinding Key="F7" Command="{Binding Playlist.NextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Jingles.StopAllCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
    </Window.CommandBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Recording bar -->
        <Border Grid.Row="0" Padding="12,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Red outline with a red dot; filled red with a pulsing white dot while recording. -->
                    <Button Style="{StaticResource RecordButton}" Command="{Binding StartRecordingCommand}" ToolTip="{loc:T Main_KaydiBaslatCtrlR}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource RecordBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RecordPulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                                             Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RecordPulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:T Main_Record}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIdle}" Value="False">
                                                <Setter Property="Text" Value="{loc:T Main_RecordingButton}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding TogglePauseCommand}" Content="{Binding PauseButtonText}" ToolTip="{loc:T Main_DuraklatDevamCtrlP}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
                                <Setter Property="services:ButtonAssist.Icon" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="services:ButtonAssist.Icon" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource TransportButton}" services:ButtonAssist.Icon="&#xE71A;" Command="{Binding StopRecordingCommand}"
                            Content="{loc:T Main_Durdur}" ToolTip="{loc:T Main_KaydiDurdurVeDosyayiKaydet}" />
                    <ToggleButton Style="{StaticResource MicrophoneToggle}" IsChecked="{Binding IsMicrophoneLive}"
                                  Content="{Binding MicrophoneButtonText}" Margin="6,0,0,0"
                                  ToolTip="{loc:T Main_KapaliykenMikrofonKaydaGirmezAcikken}" />
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,10,0" />
                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel VerticalAlignment="Center" Margin="14,0,16,0"
                                ToolTip="{loc:T Main_SesYuksekligiEbuR128Anlik}">
                        <TextBlock>
                            <Run Text="{loc:T Main_Anlik}" Foreground="{DynamicResource MutedTextBrush}" />
                            <Run Text="{Binding MomentaryLoudnessText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="{loc:T Main_Kayit}" Foreground="{DynamicResource MutedTextBrush}" />
                            <Run Text="{Binding IntegratedLoudnessText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Main_Format}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}"
                              DisplayMemberPath="DisplayName" Width="120" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                    <CheckBox Content="{loc:T Main_NormalizeEt}" IsChecked="{Binding NormalizeOnStop}" IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                              ToolTip="{loc:T Main_16LufsENormalizeEt}" />
                    <CheckBox Content="{loc:T Main_AyriIzler}" IsChecked="{Binding RecordStems}" IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center" MinWidth="0"
                              ToolTip="{loc:T Main_KarisimaEkOlarakHerKanali}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Devices and AI tools -->
        <StackPanel Grid.Row="1">
        <WrapPanel Orientation="Horizontal" Margin="4,10,0,6">
            <TextBlock Text="{loc:T Main_MikrofonEkle}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputToAdd}" DisplayMemberPath="Name"
                      Width="210" IsEnabled="{Binding IsIdle}" Margin="0,0,6,0" />
            <Button Content="{loc:T Main_Ekle}" services:ButtonAssist.Icon="&#xE710;" Command="{Binding AddMicrophoneCommand}" Margin="0,0,16,0" />
            <TextBlock Text="{loc:T Main_DinlemeCikisiKulaklik}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name"
                      Width="220" IsEnabled="{Binding IsIdle}" Margin="0,0,16,0" />
            <CheckBox Content="{loc:T Main_Ducking}" IsChecked="{Binding DuckingEnabled}" MinWidth="0"
                      VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{loc:T Main_MikrofonAcikkenYaDaKonusunca}" />
            <Slider Minimum="-30" Maximum="-3" Value="{Binding DuckLevelDb}" Width="100" VerticalAlignment="Center"
                    SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" TickFrequency="1"
                    IsEnabled="{Binding DuckingEnabled}" ToolTip="{loc:T Main_MikrofonAcikkenMuziginSeviyesi}" />
            <TextBlock Text="{Binding DuckLevelDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" Margin="6,0,16,0" />
            <ComboBox ItemsSource="{Binding DuckingModes}" SelectedItem="{Binding SelectedDuckingMode}" DisplayMemberPath="Name"
                      Width="160" IsEnabled="{Binding DuckingEnabled}" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsVoiceDucking, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{loc:T Main_MikrofonBuSeviyeyiGecinceKonusma}">
                <TextBlock Text="{loc:T Main_Esik}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Minimum="-60" Maximum="-10" Value="{Binding VoiceThresholdDb}" Width="100" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Text="{Binding VoiceThresholdDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" Margin="6,0,6,0" />
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" ToolTip="{loc:T Main_KonusmaAlgilandi}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoiceDetected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource LiveBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </WrapPanel>

        <Expander x:Name="AiExpander" Margin="0,0,0,10" DataContext="{Binding Ai}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T Main_YapayZekaYaziyaCevirmeVe}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T Main_TranskriptCikariliyor}" Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Expander.Header>
            <TextBlock Text="{loc:T Main_AraclarAsagidaKlasorGezginiVe}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
        </Expander>
        </StackPanel>

        <!-- Folder browser, playlist, jingle pad -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" DataContext="{Binding Browser}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Main_KlasorGezgini}" Style="{StaticResource PanelTitle}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE838;" Content="{loc:T Main_KlasorSec}" Command="{Binding ChooseFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE74A;" Content="{loc:T Main_UstKlasor}" Command="{Binding UpCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentFolder}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFolder}" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{loc:T Main_CiftTikKlasoreGirYa}" />
                    <ListBox x:Name="BrowserList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                             PreviewMouseLeftButtonDown="BrowserList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="BrowserList_PreviewMouseMove">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" DataContext="{Binding Playlist}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Main_CalmaListesi}" Style="{StaticResource PanelTitle}" />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}" />
                        </WrapPanel.Resources>
                        <Button services:ButtonAssist.Icon="&#xE768;" Content="{loc:T Main_Cal}" Command="{Binding PlayCommand}" ToolTip="{loc:T Main_SeciliSarkiyiCalF5}" />
                        <Button services:ButtonAssist.Icon="&#xE71A;" Content="{loc:T Main_Durdur}" Command="{Binding StopCommand}" ToolTip="{loc:T Main_MuzigiDurdurF6}" />
                        <Button services:ButtonAssist.Icon="&#xE893;" Content="{loc:T Main_Sonraki}" Command="{Binding NextCommand}" ToolTip="{loc:T Main_SonrakiSarkiF7}" />
                        <Button services:ButtonAssist.Icon="&#xE710;" Content="{loc:T Main_Ekle2}" Command="{Binding BrowseCommand}" />
                        <Button services:ButtonAssist.Icon="&#xE70E;" Command="{Binding MoveUpCommand}" ToolTip="{loc:T Main_YukariTasi}" />
                        <Button services:ButtonAssist.Icon="&#xE70D;" Command="{Binding MoveDownCommand}" ToolTip="{loc:T Main_AsagiTasi}" />
                        <Button services:ButtonAssist.Icon="&#xE74D;" Content="{loc:T Main_Kaldir}" Command="{Binding RemoveCommand}" />
                        <Button services:ButtonAssist.Icon="&#xE894;" Content="{loc:T Main_Temizle}" Command="{Binding ClearCommand}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                        <DockPanel Margin="0,4,0,0">
                            <CheckBox DockPanel.Dock="Right" Content="{loc:T Main_BitinceSonrakineGec}" IsChecked="{Binding AutoAdvance}" />
                            <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    ToolTip="{loc:T Main_SarkilarArasindaBindirmeSuresi0}">
                            <TextBlock Text="{loc:T Main_Crossfade}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="0" Maximum="10" Value="{Binding CrossfadeSeconds}" Width="140" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="0.5" SmallChange="0.5" LargeChange="1" />
                            <TextBlock Text="{Binding CrossfadeSeconds, StringFormat={loc:T Main_SecondsFormat}}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AllowDrop="True"
                             DragOver="FileDrop_DragOver" Drop="Playlist_Drop">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding PlayCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶ " Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding FilePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" DataContext="{Binding Jingles}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE710;" Content="{loc:T Main_Sekme}"
                                    Command="{Binding NewBankCommand}" ToolTip="{loc:T Main_YeniJingleSekmesi}" />
                            <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE74D;" Content="{loc:T Main_Sil}"
                                    Command="{Binding RemoveBankCommand}" ToolTip="{loc:T Main_SekmeyiSil}" />
                            <Button services:ButtonAssist.Icon="&#xE71A;" Content="{loc:T Main_TumunuDurdur}" Command="{Binding StopAllCommand}" Margin="4,0,0,0"
                                    ToolTip="{loc:T Main_CalanButunJingleLariDurdur}" />
                        </StackPanel>
                        <!-- The usage hint is a tooltip so the pads get the height. -->
                        <TextBlock Text="{loc:T Main_JinglePaneli}" Style="{StaticResource PanelTitle}"
                                   ToolTip="{loc:T Main_TiklaYaDaKosedekiTusa}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    <TabControl ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{loc:T Main_Ad}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:T Main_Satir}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:JinglePadViewModel.SizeOptions}" SelectedItem="{Binding Rows}"
                                                  Width="72" Margin="0,0,12,0" />
                                        <TextBlock Text="{loc:T Main_Sutun}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:JinglePadViewModel.SizeOptions}" SelectedItem="{Binding Columns}"
                                                  Width="72" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding ToggleCommand}" AllowDrop="True" Margin="3"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        DragOver="FileDrop_DragOver" Drop="JingleCell_Drop" ToolTip="{Binding FilePath}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{loc:T Main_DosyaSec}" Command="{Binding BrowseCommand}" />
                                                            <MenuItem Header="{loc:T Main_Temizle}" Command="{Binding ClearCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Cell" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}" Padding="6">
                                                                <Grid>
                                                                    <TextBlock x:Name="KeyLabel" Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-4,0,0"
                                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                                    <TextBlock x:Name="Label" Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource BtnHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource BtnPressedBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding HasFile}" Value="False">
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                    <Setter TargetName="KeyLabel" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- AI tools open over the middle row, so they never push the panels off a small screen. -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" DataContext="{Binding Ai}" Panel.ZIndex="1"
                Visibility="{Binding IsExpanded, ElementName=AiExpander, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Speech to text -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T Main_KonusmayiYaziyaCevirTranskript}" Style="{StaticResource PanelTitle}" />
                            <WrapPanel>
                                <TextBlock Text="{loc:T Main_Servis}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{x:Static vm:AiViewModel.TranscriptionProviders}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding TranscriptionProvider}" Width="210" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE713;" Content="{loc:T Main_Ayarlar}" Command="{Binding OpenServiceSettingsCommand}" Click="ServiceSettingsButton_Click"
                                        CommandParameter="{Binding TranscriptionProvider}" Margin="0,0,12,0"
                                        ToolTip="{loc:T Main_SeciliServisinAnahtarVeModel}" />
                                <TextBlock Text="{loc:T Main_Dil}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                         ToolTip="{loc:T Main_TrEnDeBosBirakilirsa}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="{loc:T Main_KayitBitinceOtomatikCikar}" IsChecked="{Binding TranscribeOnStop}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          ToolTip="{loc:T Main_KayitDosyasininYaninaAyniAdla}" />
                                <Button Style="{StaticResource PrimaryButton}" services:ButtonAssist.Icon="&#xE8E5;" Content="{loc:T Main_DosyaSecVeCevir}" Command="{Binding TranscribeFileCommand}" />
                                <Button services:ButtonAssist.Icon="&#xE711;" Content="{loc:T Main_Iptal}" Command="{Binding CancelTranscriptionCommand}" />
                                <Button services:ButtonAssist.Icon="&#xE8A5;" Content="{loc:T Main_TranskriptiAc}" Command="{Binding OpenTranscriptCommand}" />
                            </WrapPanel>
                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding TranscriptionProgress, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Margin="0,6,0,0"
                                         Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding TranscriptionStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Text to speech -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:T Main_MetindenSesAnonsJingle}" Style="{StaticResource PanelTitle}" />
                            <WrapPanel>
                                <TextBlock Text="{loc:T Main_Servis}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{x:Static vm:AiViewModel.SynthesisProviders}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding SynthesisProvider}" Width="210" Margin="0,0,6,0" />
                                <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE713;" Content="{loc:T Main_Ayarlar}" Command="{Binding OpenServiceSettingsCommand}" Click="ServiceSettingsButton_Click"
                                        CommandParameter="{Binding SynthesisProvider}" Margin="0,0,12,0"
                                        ToolTip="{loc:T Main_SeciliServisinAnahtarVeModel}" />
                                <TextBlock Text="{loc:T Main_Ses}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding VoiceSuggestions}" Text="{Binding Voice, UpdateSourceTrigger=LostFocus}"
                                          IsEditable="True" Width="210"
                                          ToolTip="{loc:T Main_ListedenSecinYaDaServisteki}" />
                            </WrapPanel>
                            <TextBox Text="{Binding SpeechText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="52" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                     ToolTip="{loc:T Main_SeslendirilecekMetinOrSimdiKisa}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource PrimaryButton}" services:ButtonAssist.Icon="&#xE767;" Content="{loc:T Main_SesiOlustur}" Command="{Binding SynthesizeCommand}"
                                        ToolTip="{loc:T Main_DosyaKayitKlasorundekiAnonslarKlasor}" />
                                <Button services:ButtonAssist.Icon="&#xE710;" Content="{loc:T Main_CalmaListesineEkle}" Command="{Binding AddSpeechToPlaylistCommand}" />
                                <Button services:ButtonAssist.Icon="&#xE8A9;" Content="{loc:T Main_BosJingleHucresineAta}" Command="{Binding AssignSpeechToJingleCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SynthesisStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Tab order must match AiViewModel.ServiceSettingsTabs. -->
                    <Expander x:Name="ServiceSettings" Header="{loc:T Main_ServisAyarlariApiAnahtarlariModeller}" Margin="0,10,0,0"
                              IsExpanded="{Binding IsServiceSettingsOpen, Mode=TwoWay}" Expanded="ServiceSettings_Changed">
                        <TabControl Margin="0,6,0,0" SelectedIndex="{Binding ServiceSettingsTab, Mode=TwoWay}"
                                    SelectionChanged="ServiceSettings_Changed">
                            <TabItem Header="{loc:T Main_WhisperBuBilgisayarda}">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="{loc:T Main_Model}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.WhisperModels}" DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id" SelectedValue="{Binding WhisperModel}" Width="260" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{loc:T Main_UcretsizVeInternetsizCalisirAma}" />
                                        <Run Text="{x:Static vm:AiViewModel.WhisperModelFolder}" />
                                    </TextBlock>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="OpenAI">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="{loc:T Main_ApiAnahtari}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding OpenAiKey}" Width="260" Margin="0,0,12,0" />
                                        <TextBlock Text="{loc:T Main_Adres}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                                 ToolTip="{loc:T Main_OpenaiUyumluBaskaBirServis}" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{loc:T Main_YaziyaCevirmeModeli}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.OpenAiTranscriptionModels}" IsEditable="True"
                                                  Text="{Binding OpenAiTranscriptionModel, UpdateSourceTrigger=LostFocus}" Width="190" Margin="0,0,12,0"
                                                  ToolTip="{loc:T Main_ZamanDamgaliAltyaziYalnizcaWhisper}" />
                                        <TextBlock Text="{loc:T Main_SeslendirmeModeli}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.OpenAiSpeechModels}" IsEditable="True"
                                                  Text="{Binding OpenAiSpeechModel, UpdateSourceTrigger=LostFocus}" Width="170" />
                                    </WrapPanel>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Azure OpenAI / Foundry">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="{loc:T Main_UcNokta}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiEndpoint, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,12,0"
                                                 ToolTip="{loc:T Main_OrHttpsKaynakAdiOpenai}" />
                                        <TextBlock Text="{loc:T Main_ApiAnahtari}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding AzureOpenAiKey}" Width="240" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{loc:T Main_YaziyaCevirmeDagitimi}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiTranscriptionDeployment, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0" />
                                        <TextBlock Text="{loc:T Main_SeslendirmeDagitimi}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiSpeechDeployment, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{loc:T Main_FoundryPortalindaWhisperYaDa}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Azure AI Speech (Foundry)">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="{loc:T Main_Bolge}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureSpeechRegion, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0"
                                                 ToolTip="{loc:T Main_OrWesteuropeSwedencentral}" />
                                        <TextBlock Text="{loc:T Main_Anahtar}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding AzureSpeechKey}" Width="240" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{loc:T Main_SpeechKaynagininKeysAndEndpoint}" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{loc:T Main_WindowsSesleri}">
                                <TextBlock Margin="8" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{loc:T Main_InternetsizVeUcretsizdirTurkceSes}" />
                            </TabItem>
                        </TabControl>
                    </Expander>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{loc:T Main_ApiAnahtarlariAyarDosyasindaWindows}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Mixer: channel strips scroll sideways when there are many microphones -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" Height="250">
            <Border DockPanel.Dock="Right" Style="{StaticResource PanelBorder}" Width="120" Margin="8,0,0,0" Padding="8"
                    ToolTip="{loc:T Main_KulakliktaDuyulanSesinSeviyesiMikrof}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Main_Kulaklik}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding MonitorVolume}"
                            SmallChange="0.05" LargeChange="0.1" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Right" Style="{StaticResource PanelBorder}" Width="140" Margin="8,0,0,0" Padding="8"
                    BorderBrush="{DynamicResource AccentBrush}" ToolTip="{loc:T Main_KaydaGidenToplamSes}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Main_MasterKayit}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"
                                ToolTip="{loc:T Main_Kayit1DbYiGecmesin}">
                        <CheckBox Content="{loc:T Main_Limiter}" IsChecked="{Binding LimiterEnabled}" />
                        <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}"
                                 Visibility="{Binding IsLimiting, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding MasterVolume}"
                                SmallChange="0.05" LargeChange="0.1" Margin="0,0,8,0" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding MasterMeter.Left, Mode=OneWay}" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding MasterMeter.Right, Mode=OneWay}" />
                        <Ellipse Width="8" Height="8" Margin="4,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource RecordBrush}"
                                 ToolTip="{loc:T Main_KirpilmaClip}"
                                 Visibility="{Binding MasterMeter.IsClipping, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Live stream -->
            <Border DockPanel.Dock="Right" Width="372" Margin="8,0,0,0" DataContext="{Binding Live}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Main_CanliYayin}" Style="{StaticResource PanelTitle}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource RecordBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="18" VerticalAlignment="Center"
                                   Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TargetText}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}" Margin="0,4,0,8" />
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource PrimaryButton}" services:ButtonAssist.Icon="&#xE93E;" Content="{loc:T Main_YayinaBasla}" Command="{Binding StartCommand}"
                                ToolTip="{loc:T Main_MasterSesiniIcecastSunucusunaGonder}" />
                        <Button Style="{StaticResource DangerButton}" services:ButtonAssist.Icon="&#xE71A;" Content="{loc:T Main_YayiniDurdur}" Command="{Binding StopCommand}" ToolTip="Ctrl+Shift+L" />
                        <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE713;" Content="{loc:T Main_Ayarlar2}" Command="{Binding EditSettingsCommand}" Margin="0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelStripTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Status -->
        <DockPanel Grid.Row="4" Margin="4,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE765;" Content="{loc:T Main_KisayollarF1}" Command="ApplicationCommands.Help" Margin="0" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:MainViewModel.Themes}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedTheme}" Width="90" Margin="0,0,8,0" ToolTip="{loc:T Main_GorunumAcikKoyuYaDa}" />
            <TextBlock DockPanel.Dock="Right" Text="{loc:T Main_Tema}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <!-- Each language is listed in its own name. -->
            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:MainViewModel.Languages}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedLanguage}" Width="150" Margin="0" ToolTip="{loc:T Main_LanguageTip}" />
            <TextBlock DockPanel.Dock="Right" Text="{loc:T Main_Dil}" VerticalAlignment="Center" Margin="12,0,6,0" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="{loc:T Main_KayitKlasoru}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding RecordingFolder}" VerticalAlignment="Center" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RecordingFolder}" Margin="0,0,6,0" />
                <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE70F;" Command="{Binding ChooseRecordingFolderCommand}" IsEnabled="{Binding IsIdle}" ToolTip="{loc:T Main_KayitKlasorunuDegistir}" />
                <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE838;" Content="{loc:T Main_KlasoruAc}" Command="{Binding OpenRecordingFolderCommand}" />
                <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE8EC;" Content="{loc:T Main_DosyaBilgileri}" Click="RecordingTags_Click" Margin="0"
                        ToolTip="{loc:T Main_KaydaYazilacakBaslikSunucuProgram}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
