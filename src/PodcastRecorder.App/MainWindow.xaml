<Window x:Class="PodcastRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PodcastRecorder.App.ViewModels"
        xmlns:services="clr-namespace:PodcastRecorder.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Podcast Recorder" Height="820" Width="1280" MinHeight="640" MinWidth="1000"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13">
    <!-- Keyboard shortcuts. Jingle pad keys (1-8, Q-I, A-K, Z-M by grid position) are handled in code-behind. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding StartRecordingCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding StopRecordingCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMicrophoneCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding Live.StartCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding Live.StopCommand}" />
        <KeyBinding Key="F5" Command="{Binding Playlist.PlayCommand}" />
        <KeyBinding Key="F6" Command="{Binding Playlist.StopCommand}" />
        <KeyBinding Key="F7" Command="{Binding Playlist.NextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Jingles.StopAllCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
    </Window.CommandBindings>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Recording bar -->
        <Border Grid.Row="0" Padding="12,10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding StartRecordingCommand}" ToolTip="Kaydı başlat (Ctrl+R)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource RecordBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Kaydet" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding TogglePauseCommand}" Content="{Binding PauseButtonText}"
                            ToolTip="Duraklat / devam (Ctrl+P)" />
                    <Button Style="{DynamicResource TransportButton}" Command="{Binding StopRecordingCommand}" Content="Durdur"
                            ToolTip="Kaydı durdur ve dosyayı kaydet (Ctrl+Shift+R)" />
                    <ToggleButton Style="{StaticResource MicrophoneToggle}" IsChecked="{Binding IsMicrophoneLive}"
                                  Content="{Binding MicrophoneButtonText}" Margin="10,0,0,0"
                                  ToolTip="Kapalıyken mikrofon kayda girmez. Açıkken (ducking etkinse) müzik kısılır. (Ctrl+M)" />
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,10,0" />
                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel VerticalAlignment="Center" Margin="14,0,16,0"
                                ToolTip="Ses yüksekliği (EBU R128). Anlık: son 0,4 sn. Kayıt: kaydın tamamı. Podcast'ler için yaygın hedef -16 LUFS.">
                        <TextBlock>
                            <Run Text="Anlık:" Foreground="{DynamicResource MutedTextBrush}" />
                            <Run Text="{Binding MomentaryLoudnessText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Kayıt:" Foreground="{DynamicResource MutedTextBrush}" />
                            <Run Text="{Binding IntegratedLoudnessText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}"
                              DisplayMemberPath="DisplayName" Width="130" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                    <CheckBox Content="-16 LUFS'e normalize et" IsChecked="{Binding NormalizeOnStop}" IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Kayıt bitince ses yüksekliği ölçülür ve dosya podcast standardı -16 LUFS'e getirilir. Kayıt sırasında geçici bir WAV dosyası tutulur." />
                    <CheckBox Content="Ayrı izler" IsChecked="{Binding RecordStems}" IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center"
                              ToolTip="Karışıma ek olarak her kanalı (her mikrofon, müzik, jingle) ayrı dosyaya da kaydeder. Kurgu için WAV veya FLAC önerilir." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Devices and AI tools -->
        <StackPanel Grid.Row="1">
        <WrapPanel Orientation="Horizontal" Margin="4,10,0,6">
            <TextBlock Text="Mikrofon ekle:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputToAdd}" DisplayMemberPath="Name"
                      Width="210" IsEnabled="{Binding IsIdle}" Margin="0,0,6,0" />
            <Button Content="Ekle" Command="{Binding AddMicrophoneCommand}" Margin="0,0,16,0" />
            <TextBlock Text="Dinleme çıkışı (kulaklık):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name"
                      Width="220" IsEnabled="{Binding IsIdle}" Margin="0,0,16,0" />
            <CheckBox Content="Ducking" IsChecked="{Binding DuckingEnabled}" MinWidth="0"
                      VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Mikrofon açıkken (ya da konuşunca) müziği kıs" />
            <Slider Minimum="-30" Maximum="-3" Value="{Binding DuckLevelDb}" Width="100" VerticalAlignment="Center"
                    SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" TickFrequency="1"
                    IsEnabled="{Binding DuckingEnabled}" ToolTip="Mikrofon açıkken müziğin seviyesi" />
            <TextBlock Text="{Binding DuckLevelDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" Margin="6,0,16,0" />
            <ComboBox ItemsSource="{Binding DuckingModes}" SelectedItem="{Binding SelectedDuckingMode}" DisplayMemberPath="Name"
                      Width="160" IsEnabled="{Binding DuckingEnabled}" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsVoiceDucking, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Mikrofon bu seviyeyi geçince konuşma algılanır. Ortam gürültüsü müziği kısıyorsa eşiği yükseltin.">
                <TextBlock Text="Eşik:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Minimum="-60" Maximum="-10" Value="{Binding VoiceThresholdDb}" Width="100" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Text="{Binding VoiceThresholdDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" Margin="6,0,6,0" />
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" ToolTip="Konuşma algılandı">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoiceDetected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource LiveBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </WrapPanel>

        <Expander x:Name="AiExpander" Margin="0,0,0,10" DataContext="{Binding Ai}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Yapay zeka: yazıya çevirme ve seslendirme" FontWeight="SemiBold" />
                    <TextBlock Text="  · transkript çıkarılıyor…" Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Expander.Header>
            <TextBlock Text="Araçlar aşağıda, klasör gezgini ve listelerin yerinde açık. Kapatmak için başlığa yeniden tıklayın."
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
        </Expander>
        </StackPanel>

        <!-- Folder browser, playlist, jingle pad -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" DataContext="{Binding Browser}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Klasör gezgini" Style="{StaticResource PanelTitle}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Klasör seç…" Command="{Binding ChooseFolderCommand}" />
                        <Button Content="↑ Üst klasör" Command="{Binding UpCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentFolder}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFolder}" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Çift tık: klasöre gir ya da listeye ekle. Dosyaları listeye veya jingle hücresine sürükleyin." />
                    <ListBox x:Name="BrowserList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                             PreviewMouseLeftButtonDown="BrowserList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="BrowserList_PreviewMouseMove">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" DataContext="{Binding Playlist}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Çalma listesi" Style="{StaticResource PanelTitle}" />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="▶ Çal" Command="{Binding PlayCommand}" ToolTip="Seçili şarkıyı çal (F5)" />
                        <Button Content="■ Durdur" Command="{Binding StopCommand}" ToolTip="Müziği durdur (F6)" />
                        <Button Content="⏭ Sonraki" Command="{Binding NextCommand}" ToolTip="Sonraki şarkı (F7)" />
                        <Button Content="Ekle…" Command="{Binding BrowseCommand}" />
                        <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip="Yukarı taşı" />
                        <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Aşağı taşı" />
                        <Button Content="Kaldır" Command="{Binding RemoveCommand}" />
                        <Button Content="Temizle" Command="{Binding ClearCommand}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                        <DockPanel Margin="0,4,0,0">
                            <CheckBox DockPanel.Dock="Right" Content="Bitince sonrakine geç" IsChecked="{Binding AutoAdvance}" />
                            <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    ToolTip="Şarkılar arasında bindirme süresi. 0 ise geçiş anında olur.">
                            <TextBlock Text="Crossfade:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="0" Maximum="10" Value="{Binding CrossfadeSeconds}" Width="140" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="0.5" SmallChange="0.5" LargeChange="1" />
                            <TextBlock Text="{Binding CrossfadeSeconds, StringFormat={}{0:0.0} sn}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AllowDrop="True"
                             DragOver="FileDrop_DragOver" Drop="Playlist_Drop">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding PlayCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶ " Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding FilePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" DataContext="{Binding Jingles}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ Sekme" Command="{Binding NewBankCommand}" />
                            <Button Content="Sekmeyi sil" Command="{Binding RemoveBankCommand}" />
                            <Button Content="Tümünü durdur" Command="{Binding StopAllCommand}" Margin="0"
                                    ToolTip="Çalan bütün jingle'ları durdur (Esc)" />
                        </StackPanel>
                        <!-- The usage hint is a tooltip so the pads get the height. -->
                        <TextBlock Text="Jingle paneli ⓘ" Style="{StaticResource PanelTitle}"
                                   ToolTip="Tıkla ya da köşedeki tuşa bas: çal / durdur. Dosyayı hücreye sürükleyin; sağ tık ile dosya seçin veya temizleyin." />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    <TabControl ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Ad:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                                        <TextBlock Text="Satır:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:JinglePadViewModel.SizeOptions}" SelectedItem="{Binding Rows}"
                                                  Width="72" Margin="0,0,12,0" />
                                        <TextBlock Text="Sütun:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:JinglePadViewModel.SizeOptions}" SelectedItem="{Binding Columns}"
                                                  Width="72" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding ToggleCommand}" AllowDrop="True" Margin="3"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        DragOver="FileDrop_DragOver" Drop="JingleCell_Drop" ToolTip="{Binding FilePath}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Dosya seç…" Command="{Binding BrowseCommand}" />
                                                            <MenuItem Header="Temizle" Command="{Binding ClearCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Cell" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}" Padding="6">
                                                                <Grid>
                                                                    <TextBlock x:Name="KeyLabel" Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-4,0,0"
                                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                                    <TextBlock x:Name="Label" Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding HasFile}" Value="False">
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                    <Setter TargetName="KeyLabel" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- AI tools open over the middle row, so they never push the panels off a small screen. -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" DataContext="{Binding Ai}" Panel.ZIndex="1"
                Visibility="{Binding IsExpanded, ElementName=AiExpander, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Speech to text -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Konuşmayı yazıya çevir (transkript)" Style="{StaticResource PanelTitle}" />
                            <WrapPanel>
                                <TextBlock Text="Servis:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{x:Static vm:AiViewModel.TranscriptionProviders}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding TranscriptionProvider}" Width="210" Margin="0,0,12,0" />
                                <TextBlock Text="Dil:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                         ToolTip="tr, en, de… Boş bırakılırsa dil otomatik algılanır." />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="Kayıt bitince otomatik çıkar" IsChecked="{Binding TranscribeOnStop}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          ToolTip="Kayıt dosyasının yanına aynı adla .txt (zaman damgalı metin) ve .srt (altyazı) yazılır." />
                                <Button Content="Dosya seç ve çevir…" Command="{Binding TranscribeFileCommand}" />
                                <Button Content="İptal" Command="{Binding CancelTranscriptionCommand}" />
                                <Button Content="Transkripti aç" Command="{Binding OpenTranscriptCommand}" />
                            </WrapPanel>
                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding TranscriptionProgress, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Margin="0,6,0,0"
                                         Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding TranscriptionStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Text to speech -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Metinden ses (anons, jingle)" Style="{StaticResource PanelTitle}" />
                            <WrapPanel>
                                <TextBlock Text="Servis:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{x:Static vm:AiViewModel.SynthesisProviders}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding SynthesisProvider}" Width="210" Margin="0,0,12,0" />
                                <TextBlock Text="Ses:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding VoiceSuggestions}" Text="{Binding Voice, UpdateSourceTrigger=LostFocus}"
                                          IsEditable="True" Width="210"
                                          ToolTip="Listeden seçin ya da servisteki bir sesin adını yazın." />
                            </WrapPanel>
                            <TextBox Text="{Binding SpeechText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="52" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                     ToolTip="Seslendirilecek metin, ör. &quot;Şimdi kısa bir reklam arası veriyoruz.&quot;" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Sesi oluştur" Command="{Binding SynthesizeCommand}" FontWeight="SemiBold"
                                        ToolTip="Dosya, kayıt klasöründeki Anonslar klasörüne yazılır." />
                                <Button Content="Çalma listesine ekle" Command="{Binding AddSpeechToPlaylistCommand}" />
                                <Button Content="Boş jingle hücresine ata" Command="{Binding AssignSpeechToJingleCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SynthesisStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Expander Header="Servis ayarları (API anahtarları, modeller)" Margin="0,10,0,0">
                        <TabControl Margin="0,6,0,0">
                            <TabItem Header="Whisper (bu bilgisayarda)">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.WhisperModels}" DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id" SelectedValue="{Binding WhisperModel}" Width="260" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="Ücretsiz ve internetsiz çalışır, ama işlemcide bulut servislerinden yavaştır. Model ilk kullanımda indirilir:" />
                                        <Run Text="{x:Static vm:AiViewModel.WhisperModelFolder}" />
                                    </TextBlock>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="OpenAI">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="API anahtarı:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding OpenAiKey}" Width="260" Margin="0,0,12,0" />
                                        <TextBlock Text="Adres:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                                 ToolTip="OpenAI uyumlu başka bir servis kullanıyorsanız adresini yazın." />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Yazıya çevirme modeli:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.OpenAiTranscriptionModels}" IsEditable="True"
                                                  Text="{Binding OpenAiTranscriptionModel, UpdateSourceTrigger=LostFocus}" Width="190" Margin="0,0,12,0"
                                                  ToolTip="Zaman damgalı altyazı yalnızca whisper-1 ile çıkar; gpt-4o modelleri daha doğru ama her 10 dakikayı tek parça verir." />
                                        <TextBlock Text="Seslendirme modeli:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static vm:AiViewModel.OpenAiSpeechModels}" IsEditable="True"
                                                  Text="{Binding OpenAiSpeechModel, UpdateSourceTrigger=LostFocus}" Width="170" />
                                    </WrapPanel>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Azure OpenAI / Foundry">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="Uç nokta:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiEndpoint, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,12,0"
                                                 ToolTip="ör. https://kaynak-adi.openai.azure.com ya da https://kaynak-adi.services.ai.azure.com" />
                                        <TextBlock Text="API anahtarı:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding AzureOpenAiKey}" Width="240" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="Yazıya çevirme dağıtımı:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiTranscriptionDeployment, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0" />
                                        <TextBlock Text="Seslendirme dağıtımı:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureOpenAiSpeechDeployment, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Foundry portalında whisper ya da gpt-4o-transcribe ve tts ya da gpt-4o-mini-tts modellerini dağıtın; burada dağıtım (deployment) adlarını yazın." />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Azure AI Speech (Foundry)">
                                <StackPanel Margin="8">
                                    <WrapPanel>
                                        <TextBlock Text="Bölge:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding AzureSpeechRegion, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0"
                                                 ToolTip="ör. westeurope, swedencentral" />
                                        <TextBlock Text="Anahtar:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <PasswordBox services:PasswordBoxAssist.Password="{Binding AzureSpeechKey}" Width="240" />
                                    </WrapPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Speech kaynağının &quot;Keys and Endpoint&quot; sayfasındaki anahtar ve bölge. Türkçe için tr-TR-EmelNeural ve tr-TR-AhmetNeural sesleri hazır gelir." />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Windows sesleri">
                                <TextBlock Margin="8" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="İnternetsiz ve ücretsizdir. Türkçe ses için Windows Ayarlar › Saat ve dil › Konuşma bölümünden Türkçe konuşma paketini ekleyin; ses listesi uygulama açılırken okunur." />
                            </TabItem>
                        </TabControl>
                    </Expander>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="API anahtarları ayar dosyasında Windows kullanıcınıza özel olarak şifrelenir. Bulut servislerine gönderilen ses ve metin için ilgili servisin ücret ve gizlilik koşulları geçerlidir." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Mixer: channel strips scroll sideways when there are many microphones -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" Height="250">
            <Border DockPanel.Dock="Right" Style="{StaticResource PanelBorder}" Width="120" Margin="8,0,0,0" Padding="8"
                    ToolTip="Kulaklıkta duyulan sesin seviyesi. Mikrofon varsayılan olarak kulaklığa verilmez (gecikmeli yankı olmasın diye), ama her zaman kayda girer.">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kulaklık" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding MonitorVolume}"
                            SmallChange="0.05" LargeChange="0.1" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Right" Style="{StaticResource PanelBorder}" Width="140" Margin="8,0,0,0" Padding="8"
                    BorderBrush="{DynamicResource AccentBrush}" ToolTip="Kayda giden toplam ses">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Master (kayıt)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"
                                ToolTip="Kayıt -1 dB'yi geçmesin diye tepe seviyeleri anlık kısar. Turuncu: şu an kısıyor.">
                        <CheckBox Content="Limiter" IsChecked="{Binding LimiterEnabled}" />
                        <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}"
                                 Visibility="{Binding IsLimiting, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding MasterVolume}"
                                SmallChange="0.05" LargeChange="0.1" Margin="0,0,8,0" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding MasterMeter.Left, Mode=OneWay}" />
                        <ProgressBar Style="{StaticResource VerticalMeter}" Value="{Binding MasterMeter.Right, Mode=OneWay}" />
                        <Ellipse Width="8" Height="8" Margin="4,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource RecordBrush}"
                                 ToolTip="Kırpılma (clip)"
                                 Visibility="{Binding MasterMeter.IsClipping, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Live stream -->
            <Border DockPanel.Dock="Right" Width="320" Margin="8,0,0,0" DataContext="{Binding Live}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Canlı yayın" Style="{StaticResource PanelTitle}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource RecordBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="18" VerticalAlignment="Center"
                                   Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TargetText}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}" Margin="0,4,0,8" />
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Yayına başla" Command="{Binding StartCommand}" FontWeight="SemiBold"
                                ToolTip="Master sesini Icecast sunucusuna gönder (Ctrl+L)" />
                        <Button Content="Yayını durdur" Command="{Binding StopCommand}" ToolTip="Ctrl+Shift+L" />
                        <Button Content="Ayarlar…" Command="{Binding EditSettingsCommand}" Margin="0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                </DockPanel>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelStripTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Status -->
        <DockPanel Grid.Row="4" Margin="4,10,0,0">
            <Button DockPanel.Dock="Right" Content="Kısayollar (F1)" Command="ApplicationCommands.Help" Margin="0" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:MainViewModel.Themes}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedTheme}" Width="90" Margin="0,0,8,0" ToolTip="Görünüm: açık, koyu ya da Windows'a göre" />
            <TextBlock DockPanel.Dock="Right" Text="Tema:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="Kayıt klasörü:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding RecordingFolder}" VerticalAlignment="Center" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RecordingFolder}" Margin="0,0,6,0" />
                <Button Content="…" Command="{Binding ChooseRecordingFolderCommand}" IsEnabled="{Binding IsIdle}" ToolTip="Kayıt klasörünü değiştir" />
                <Button Content="Klasörü aç" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
