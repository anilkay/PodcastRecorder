<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App colours for the dark theme; same keys as Light.xaml. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1C1D20" />
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2C30" />
    <SolidColorBrush x:Key="BorderBrush" Color="#41444A" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8E9EC" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A4A9B1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B95F7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24324A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RecordBrush" Color="#F05A5A" />
    <SolidColorBrush x:Key="RecordSoftBrush" Color="#46252A" />
    <SolidColorBrush x:Key="MeterBrush" Color="#4CC473" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#3A3D43" />
    <SolidColorBrush x:Key="LiveBrush" Color="#45C771" />
    <SolidColorBrush x:Key="LiveSoftBrush" Color="#1E3A28" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A524" />

    <!-- Buttons (Themes/Controls.xaml) -->
    <SolidColorBrush x:Key="BtnBackgroundBrush" Color="#33363C" />
    <SolidColorBrush x:Key="BtnHoverBrush" Color="#3D4047" />
    <SolidColorBrush x:Key="BtnPressedBrush" Color="#2C2F34" />
    <SolidColorBrush x:Key="BtnBorderBrush" Color="#4B4F57" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#383B41" />
    <SolidColorBrush x:Key="GhostPressedBrush" Color="#2F3237" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#3B7BE8" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#4C89F0" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#326BD3" />
    <SolidColorBrush x:Key="RecordFillBrush" Color="#D94343" />
    <SolidColorBrush x:Key="RecordFillHoverBrush" Color="#E55252" />
    <SolidColorBrush x:Key="RecordSoftHoverBrush" Color="#5A2D33" />
    <SolidColorBrush x:Key="MuteSoftBrush" Color="#46252A" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#7FB0FF" />
</ResourceDictionary>
