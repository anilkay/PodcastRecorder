<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App colours for the light theme. Dark.xaml defines the same keys; use them with DynamicResource. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6670" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCE7FB" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RecordBrush" Color="#D93A3A" />
    <SolidColorBrush x:Key="RecordSoftBrush" Color="#FBE3E3" />
    <SolidColorBrush x:Key="MeterBrush" Color="#3DAA5C" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="LiveBrush" Color="#2E9E50" />
    <SolidColorBrush x:Key="LiveSoftBrush" Color="#DFF3E5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8890C" />

    <!-- Buttons (Themes/Controls.xaml) -->
    <SolidColorBrush x:Key="BtnBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BtnHoverBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="BtnPressedBrush" Color="#E4E8ED" />
    <SolidColorBrush x:Key="BtnBorderBrush" Color="#CBD1D9" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="GhostPressedBrush" Color="#DCE0E6" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#2F6FDB" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#2862C7" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#2155AE" />
    <SolidColorBrush x:Key="RecordFillBrush" Color="#D93A3A" />
    <SolidColorBrush x:Key="RecordFillHoverBrush" Color="#C73232" />
    <SolidColorBrush x:Key="RecordSoftHoverBrush" Color="#F7D2D2" />
    <SolidColorBrush x:Key="MuteSoftBrush" Color="#FBE3E3" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#2F6FDB" />
</ResourceDictionary>
