<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:PodcastRecorder.App.Services">
    <!--
        The app's buttons. Full templates, so they do not depend on the Fluent button style; every
        colour comes from Themes/Light.xaml or Dark.xaml through DynamicResource, so switching the
        theme restyles them. Variants:
          (implicit) / SecondaryButton  subtle fill and a 1 px border - the default
          PrimaryButton                 filled accent, for the main action of a panel or dialog
          GhostButton                   transparent until hovered, for toolbar actions
          DangerButton                  red outline, for stopping something that is live
          TransportButton               the larger record bar buttons
          (implicit ToggleButton)       accent when checked; MuteToggle is red when checked
        An icon goes in front of the label with services:ButtonAssist.Icon (a Segoe icon glyph).
    -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Keyboard focus only (WPF shows FocusVisualStyle for keyboard navigation, not for clicks). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="AppButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding services:ButtonAssist.Icon}" FontFamily="{StaticResource IconFont}"
                           FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="services:ButtonAssist.Icon" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Icon-only button: no gap after the glyph. -->
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AppButtonBase" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BtnBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <!-- A style trigger (not a template one), so a variant can override it, e.g. the record button while recording. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GhostPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordSoftHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <!-- Record: red outline with a red dot; filled red with a pulsing dot while recording (Kaydet → Kayıtta). -->
    <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordSoftHoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecordFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <!-- The button is disabled while recording; keep the on-air state fully visible. -->
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource AppButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource AppToggleButton}" />

    <!-- The on-air switch in the record bar: green with a microphone while live, crossed out when off. -->
    <Style x:Key="MicrophoneToggle" TargetType="ToggleButton" BasedOn="{StaticResource AppToggleButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="services:ButtonAssist.Icon" Value="&#xEC54;" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="services:ButtonAssist.Icon" Value="&#xE720;" />
                <Setter Property="Background" Value="{DynamicResource LiveSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A channel's mute: red when the channel is silenced. -->
    <Style x:Key="MuteToggle" TargetType="ToggleButton" BasedOn="{StaticResource AppToggleButton}">
        <Setter Property="services:ButtonAssist.Icon" Value="&#xE767;" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="services:ButtonAssist.Icon" Value="&#xE74F;" />
                <Setter Property="Background" Value="{DynamicResource MuteSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
