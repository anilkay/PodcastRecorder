<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The app logo as vector drawings, drawn from assets/logo/logo.svg (WPF cannot show SVG).
        The PNGs and logo.ico in assets/logo are rendered from these drawings, so keep them in step.
        LogoImage is the full logo; LogoImageSmall drops the sound waves and the grille for 16-24 px.
    -->
    <LinearGradientBrush x:Key="LogoBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3B2A8F" />
        <GradientStop Offset="1" Color="#14112E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoMicBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#D9DCF5" />
    </LinearGradientBrush>
    <Pen x:Key="LogoWavePen" Brush="#8C7CFF" Thickness="10" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="LogoGrillePen" Brush="#B8BCE8" Thickness="5" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="LogoStandPen" Brush="#FFFFFF" Thickness="12" StartLineCap="Round" EndLineCap="Round" />
    <Pen x:Key="LogoDotPen" Brush="#14112E" Thickness="8" />

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Keeps the 256 x 256 frame (with its 8 px margin) as the image bounds. -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LogoBackgroundBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup Opacity="0.55">
                    <GeometryDrawing Pen="{StaticResource LogoWavePen}" Geometry="M62,92 a72,72 0 0 0 0,64" />
                    <GeometryDrawing Pen="{StaticResource LogoWavePen}" Geometry="M194,92 a72,72 0 0 1 0,64" />
                </DrawingGroup>
                <DrawingGroup Opacity="0.3">
                    <GeometryDrawing Pen="{StaticResource LogoWavePen}" Geometry="M40,74 a98,98 0 0 0 0,100" />
                    <GeometryDrawing Pen="{StaticResource LogoWavePen}" Geometry="M216,74 a98,98 0 0 1 0,100" />
                </DrawingGroup>
                <GeometryDrawing Brush="{StaticResource LogoMicBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="96,44,64,112" RadiusX="32" RadiusY="32" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Pen="{StaticResource LogoGrillePen}" Geometry="M110,80 H146 M110,96 H146 M110,112 H146" />
                <GeometryDrawing Pen="{StaticResource LogoStandPen}" Geometry="M80,128 a48,48 0 0 0 96,0" />
                <GeometryDrawing Pen="{StaticResource LogoStandPen}" Geometry="M128,176 V204 M100,208 H156" />
                <GeometryDrawing Brush="#FF3B4E" Pen="{StaticResource LogoDotPen}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="190,66" RadiusX="24" RadiusY="24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 16-24 px: background, microphone, stand and record dot only; the thin details would blur. -->
    <DrawingImage x:Key="LogoImageSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LogoBackgroundBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LogoMicBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="96,44,64,112" RadiusX="32" RadiusY="32" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Pen="{StaticResource LogoStandPen}" Geometry="M80,128 a48,48 0 0 0 96,0" />
                <GeometryDrawing Pen="{StaticResource LogoStandPen}" Geometry="M128,176 V204 M100,208 H156" />
                <GeometryDrawing Brush="#FF3B4E" Pen="{StaticResource LogoDotPen}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="190,66" RadiusX="24" RadiusY="24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
