<Window x:Class="PodcastRecorder.App.RecordingTagsWindow"
        Icon="pack://application:,,,/Assets/logo.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PodcastRecorder.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PodcastRecorder.App.ViewModels"
        xmlns:app="clr-namespace:PodcastRecorder.App"
        xmlns:services="clr-namespace:PodcastRecorder.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecordingTagsViewModel}"
        Title="{loc:T Tags_DosyaBilgileri}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontSize="13">
    <Window.Resources>
        <app:ImagePathConverter x:Key="ImagePath" />
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                   Text="{loc:T Tags_KayitBitinceBuBilgilerDosyaya}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,12,8" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="{loc:T Tags_Baslik}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:T Tags_BosBirakilirsaDosyaAdiKullanilir}" />

                <TextBlock Grid.Row="1" Text="{loc:T Tags_SunucuSanatci}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="{loc:T Tags_ProgramAlbum}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Text="{loc:T Tags_BolumNo}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                             ToolTip="{loc:T Tags_SonrakiKaydinBolumNumarasiHer}" />
                    <TextBlock Text="{loc:T Tags_Yil}" Margin="16,0,8,8" />
                    <TextBox Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="{loc:T Tags_Tur}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Text="{loc:T Tags_Aciklama}" VerticalAlignment="Top" Margin="0,6,12,8" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!-- Cover -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:T Tags_KapakResmi}" Margin="0,0,0,6" />
                <Border Width="150" Height="150" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource PanelBrush}" ToolTip="{Binding CoverImagePath}">
                    <Grid>
                        <TextBlock Text="{loc:T Tags_KapakYok}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding CoverImagePath, Converter={StaticResource ImagePath}}" Stretch="Uniform" Margin="2" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button services:ButtonAssist.Icon="&#xE91B;" Content="{loc:T Tags_Sec}" Command="{Binding ChooseCoverCommand}" ToolTip="{loc:T Tags_JpegYaDaPngKare}" />
                    <Button Style="{StaticResource GhostButton}" services:ButtonAssist.Icon="&#xE74D;" ToolTip="{loc:T Main_Kaldir}" Command="{Binding ClearCoverCommand}" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />

        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:T Tags_Kapat}" IsCancel="True" IsDefault="True" MinWidth="90" Margin="0" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" services:ButtonAssist.Icon="&#xE74E;" Content="{loc:T Tags_SonKaydaYaz}" Command="{Binding WriteToLastRecordingCommand}"
                        ToolTip="{loc:T Tags_BuBilgileriBuOturumdakiSon}" />
                <Button services:ButtonAssist.Icon="&#xE8E5;" Content="{loc:T Tags_DosyayaYaz}" Command="{Binding WriteToFileCommand}"
                        ToolTip="{loc:T Tags_BirSesDosyasiSecinBu}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
