<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PodcastRecorder.App.Controls"
             x:Class="PodcastRecorder.App.App"
             Name="Podcast Recorder"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The app colours; the same keys as the WPF app's Themes/Light.xaml and Dark.xaml. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
                    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6670" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDB" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCE7FB" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RecordBrush" Color="#D93A3A" />
                    <SolidColorBrush x:Key="RecordSoftBrush" Color="#FBE3E3" />
                    <SolidColorBrush x:Key="MeterBrush" Color="#3DAA5C" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="LiveBrush" Color="#2E9E50" />
                    <SolidColorBrush x:Key="LiveSoftBrush" Color="#DFF3E5" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#E8890C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBrush" Color="#1C1D20" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#2A2C30" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#41444A" />
                    <SolidColorBrush x:Key="TextBrush" Color="#E8E9EC" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A4A9B1" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#5B95F7" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24324A" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RecordBrush" Color="#F05A5A" />
                    <SolidColorBrush x:Key="RecordSoftBrush" Color="#46252A" />
                    <SolidColorBrush x:Key="MeterBrush" Color="#4CC473" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#3A3D43" />
                    <SolidColorBrush x:Key="LiveBrush" Color="#45C771" />
                    <SolidColorBrush x:Key="LiveSoftBrush" Color="#1E3A28" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F5A524" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.panel.alert">
            <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style Selector="CheckBox, ComboBox, Slider:horizontal">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="WrapPanel > :is(Control)">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="controls|LevelBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Fill" Value="{DynamicResource MeterBrush}" />
            <Setter Property="Track" Value="{DynamicResource MeterTrackBrush}" />
        </Style>
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- The on-air switch: green while the microphone is live. -->
        <Style Selector="ToggleButton.onair">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="ToggleButton.onair:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LiveSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="ToggleButton.onair:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- Jingle pads -->
        <Style Selector="Button.pad">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.pad.empty">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.pad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.pad.playing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.pad.playing TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.pad TextBlock.key">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="-2,-4,0,0" />
        </Style>

        <Style Selector="Ellipse.voice">
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Ellipse.voice.on">
            <Setter Property="Fill" Value="{DynamicResource LiveBrush}" />
        </Style>
    </Application.Styles>
</Application>
