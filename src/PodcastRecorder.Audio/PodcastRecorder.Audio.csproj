<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PodcastRecorder.Audio</RootNamespace>
    <!-- Strings.resx is Turkish; Strings.en.resx becomes the en satellite assembly. -->
    <NeutralLanguage>tr</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Only for its native RNNoise builds (win-x64/x86, linux-x64/arm64); the interop is our own. -->
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" ExcludeAssets="compile" />
  </ItemGroup>

  <!--
    macOS has no RNNoise package: the CI builds librnnoise.dylib with macOS/build-rnnoise.sh (in the
    Avalonia project) and passes its path as RNNOISE_DYLIB. It then lands next to the app, the tests
    and every publish, where the runtime finds it under the name "rnnoise".
  -->
  <ItemGroup Condition="'$(RNNOISE_DYLIB)' != '' And Exists('$(RNNOISE_DYLIB)')">
    <None Include="$(RNNOISE_DYLIB)" Link="librnnoise.dylib"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PodcastRecorder.Audio.Tests" />
    <InternalsVisibleTo Include="PodcastRecorder.Audio.PortAudio" />
  </ItemGroup>

</Project>
